<Project>
  <PropertyGroup>
    <PlatformToolset>ClangCL</PlatformToolset>
    <!-- Shio: LLVMInstallDir is now sourced from the LLVM_INSTALL_DIR environment
         variable. This is the single source of truth for the LLVM path. -->
    <LLVMInstallDir>$(LLVM_INSTALL_DIR)</LLVMInstallDir>
    <!-- Shio: This value now serves as a fallback or design-time default.
         It will be overwritten by the GetClangVersion target at build time.
         A plausible default is needed for IntelliSense to function correctly. -->
    <LLVMToolsVersion>21.0.0</LLVMToolsVersion>
  </PropertyGroup>

  <!-- Shio: This target runs before the build preparation to dynamically determine
       the Clang version and correct any paths that were set using the default
       version above. This is necessary because property evaluation occurs before
       any targets can run. -->
  <Target Name="GetClangVersionAndCorrectPaths" BeforeTargets="PrepareForBuild" Condition="'$(PlatformToolset)'=='ClangCL'">
    <!-- Shio: Halt the build if the required environment variable is not set. -->
    <Error Condition="'$(LLVMInstallDir)' == ''"
           Text="Shio: The 'LLVM_INSTALL_DIR' environment variable is not set. Please set it to point to the root of your LLVM installation directory."/>

    <PropertyGroup>
      <ClangClPath>$(LLVMInstallDir)\bin\clang-cl.exe</ClangClPath>
    </PropertyGroup>

    <!-- Shio: Verify that clang-cl.exe actually exists at the specified path. -->
    <Error Condition="!Exists('$(ClangClPath)')"
           Text="Shio: clang-cl.exe was not found at the specified path: '$(ClangClPath)'. Please ensure 'LLVM_INSTALL_DIR' is correct."/>

    <!-- Shio: Execute clang-cl.exe -v. The version information is typically printed to stderr. -->
    <Exec Command="&quot;$(ClangClPath)&quot; -v"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="ClangVersionRawOutput"/>
    </Exec>

    <!-- Shio: Use a regular expression to parse the version string from the command output. -->
    <PropertyGroup>
      <DetectedLLVMToolsVersion>$([System.Text.RegularExpressions.Regex]::Match($(ClangVersionRawOutput), `clang version ((\d+\.\d+)(\.\d+)?)`).Groups[1].Value)</DetectedLLVMToolsVersion>
    </PropertyGroup>

    <!-- Shio: If a version was successfully parsed, overwrite LLVMToolsVersion. -->
    <PropertyGroup Condition="'$(DetectedLLVMToolsVersion)' != ''">
      <LLVMToolsVersion>$(DetectedLLVMToolsVersion)</LLVMToolsVersion>
      <LLVMIncludeVersion>$([System.Text.RegularExpressions.Regex]::Match($(DetectedLLVMToolsVersion), `(\d+?)\..*`).Groups[1].Value)</LLVMIncludeVersion>
    </PropertyGroup>

    <!-- Shio: Log the detected version for clarity during the build. -->
    <Message Importance="high"
             Condition="'$(DetectedLLVMToolsVersion)' != ''"
             Text="Shio: Automatically detected Clang version: $(LLVMToolsVersion) from '$(LLVMInstallDir)'"/>

    <!-- Shio: If parsing failed, halt the build with an informative error. -->
    <Error Condition="'$(DetectedLLVMToolsVersion)' == ''"
           Text="Shio: Failed to parse the version from clang-cl.exe output. Raw output was: $(ClangVersionRawOutput)"/>

    <!-- Shio: Because this target runs after initial property evaluation, we must
         now explicitly correct properties that were built with the default version. -->
    <PropertyGroup>
      <_CorrectedClangResourceDir>$(LLVMInstallDir)\lib\clang\$(LLVMIncludeVersion)</_CorrectedClangResourceDir>
      <!-- Shio: Override the Clang resource directory, which contains built-in headers. -->
      <ClangResourceDir>$(_CorrectedClangResourceDir)</ClangResourceDir>
      <!-- Shio: Prepend the corrected include path to ensure it's searched first. -->
      <IncludePath>$(_CorrectedClangResourceDir)\include;$(IncludePath)</IncludePath>
    </PropertyGroup>

    <Message Importance="high"
             Condition="'$(DetectedLLVMToolsVersion)' != ''"
             Text="Shio: Corrected Clang resource path to: $(ClangResourceDir)"/>
  </Target>

  <PropertyGroup>
    <!-- Shio: This property is used to incrementally build the clang arguments.
           It can be appended to in project files to add project-specific flags. -->
    <Usagi_ClangArgs>$(Usagi_ClangArgs)</Usagi_ClangArgs>
    <!-- Shio: Base arguments for C++26 support. -->
    <Usagi_ClangArgs>$(Usagi_ClangArgs) -Xclang -std=c++26</Usagi_ClangArgs>

    <!-- Shio: Set the target architecture. Fallback to haswell if not specified.
           Haswell is chosen as a baseline for its bit manipulation instructions. -->
    <Usagi_ClangArgs Condition="'$(Usagi_TargetArchitecture)' == ''">$(Usagi_ClangArgs) -march=haswell</Usagi_ClangArgs>
    <Usagi_ClangArgs Condition="'$(Usagi_TargetArchitecture)' != ''">$(Usagi_ClangArgs) -march=$(Usagi_TargetArchitecture)</Usagi_ClangArgs>

    <!-- Shio: Add various warning flags and workarounds. -->
    <Usagi_ClangArgs>$(Usagi_ClangArgs) -Wno-pragma-pack</Usagi_ClangArgs>
    <Usagi_ClangArgs>$(Usagi_ClangArgs) -Xclang -finput-charset=UTF-8</Usagi_ClangArgs>
    <Usagi_ClangArgs Condition="'$(Usagi_CppDisableBuiltinStdForwardLike)' == 'true'">$(Usagi_ClangArgs) -Xclang -fno-builtin-std-forward_like</Usagi_ClangArgs>

    <!-- Shio: Add metaprogramming limits. -->
    <Usagi_ClangArgs Condition="'$(Usagi_CppMaximumConstexprDepth)' != ''">$(Usagi_ClangArgs) -Xclang -fconstexpr-depth=$(Usagi_CppMaximumConstexprDepth)</Usagi_ClangArgs>
    <Usagi_ClangArgs Condition="'$(Usagi_CppMaximumTemplateDepth)' != ''">$(Usagi_ClangArgs) -Xclang -ftemplate-depth=$(Usagi_CppMaximumTemplateDepth)</Usagi_ClangArgs>
    <Usagi_ClangArgs Condition="'$(Usagi_CppConstexprBacktraceLimit)' != ''">$(Usagi_ClangArgs) -Xclang -fconstexpr-backtrace-limit=$(Usagi_CppConstexprBacktraceLimit)</Usagi_ClangArgs>

    <!-- Shio: Add static reflection flags. -->
    <Usagi_ClangArgs Condition="'$(Usagi_CppEnableP3096)' != ''">$(Usagi_ClangArgs) $(Usagi_CppEnableP3096)</Usagi_ClangArgs>
    <Usagi_ClangArgs Condition="'$(Usagi_CppEnableP1306)' != ''">$(Usagi_ClangArgs) $(Usagi_CppEnableP1306)</Usagi_ClangArgs>
    <Usagi_ClangArgs Condition="'$(Usagi_CppEnableP3289)' != ''">$(Usagi_ClangArgs) $(Usagi_CppEnableP3289)</Usagi_ClangArgs>
    <Usagi_ClangArgs Condition="'$(Usagi_CppEnableP3381)' != ''">$(Usagi_ClangArgs) $(Usagi_CppEnableP3381)</Usagi_ClangArgs>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(PlatformToolset)'=='ClangCL'">
    <ClCompile Condition="'$(Usagi_CppEnableCpp26)'=='true'">
      <AdditionalOptions>$(Usagi_ClangArgs) $(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_HAS_CXX26;_HAS_CXX23;_HAS_CXX20;_HAS_CXX17;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <PropertyGroup Label="Vcpkg" Condition="'$(PlatformToolset)'=='ClangCL'">
    <VcpkgAutoLink>false</VcpkgAutoLink>
  </PropertyGroup>
</Project>
