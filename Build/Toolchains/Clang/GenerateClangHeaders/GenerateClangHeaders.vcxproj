<?xml version="1.0" encoding="utf-8"?>

<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="UnitTest|x64">
      <Configuration>UnitTest</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{b9cde871-cf54-4bf4-b1b0-98eeb8d215bd}</ProjectGuid>
    <RootNamespace>GenerateClangHeaders</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup>
    <!-- ConfigurationType MUST be specified BEFORE importing Microsoft.Cpp.props. -->
    <!-- Otherwise all projects become Application. -->
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='UnitTest'">
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- But include paths must be defined AFTER importing Microsoft.Cpp.props. -->
  <PropertyGroup>
    <IncludePath>$(Usagi_IncludePaths);$(IncludePath)</IncludePath>
    <LibraryPath>$(Usagi_LibraryPaths);$(LibraryPath)</LibraryPath>
    <ExternalIncludeDirectories>$(ProjectDir);$(ExternalIncludeDirectories)</ExternalIncludeDirectories>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlatformToolset)'=='ClangCL'">
    <!-- Dumps Predefined Macros -->
    <Usagi_ClangArgs>$(Usagi_ClangArgs) /clang:-dM /E -</Usagi_ClangArgs>
  </PropertyGroup>
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
  <Target Name="Build">
    <!--
      Shio:
      This target intercepts the standard build process. Instead of compiling source files,
      it invokes the project's specific clang-cl.exe (via $(LLVMInstallDir)) with the exact arguments
      configured for the Usagi Engine workspace (via the $(Usagi_ClangArgs) property).

      We delegate the execution to a PowerShell script to avoid race conditions and file locking
      issues ("The requested operation cannot be performed on a file with a user-mapped section open")
      that occur when using sequential MSBuild `Exec` redirects (`>` and `>>`).

      The PowerShell script safely pipes an empty string into Clang to trigger the evaluation,
      captures the stdout cleanly into memory, formats the #ifdef guards, and performs a single,
      atomic file write.
    -->
    <Message Importance="High" Text="Generating clang_builtin_macros.hpp from ClangCL definitions via PowerShell script..." />
    <Exec Command="pwsh.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/GenerateMacros.ps1&quot; -ClangClPath &quot;$(ClangClPath)&quot; -ClangArgs &quot;$(Usagi_ClangArgs)&quot; -OutputFile &quot;$(MSBuildProjectDirectory)/clang_builtin_macros.hpp&quot;" />
  </Target>
</Project>
