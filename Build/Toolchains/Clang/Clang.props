<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PlatformToolset>ClangCL</PlatformToolset>
    <!-- Shio: LLVMInstallDir is now sourced from the LLVM_INSTALL_DIR environment
         variable. This is the single source of truth for the LLVM path. -->
    <LLVMInstallDir>$(LLVM_INSTALL_DIR)</LLVMInstallDir>
    <!-- Shio: This value now serves as a fallback or design-time default.
         It will be overwritten by the GetClangVersion target at build time.
         A plausible default is needed for IntelliSense to function correctly. -->
    <!-- Now `Clang.version.props` figures out the correct LLVM toolchain version. -->
    <!-- <LLVMToolsVersion>21.0.0</LLVMToolsVersion>-->
  </PropertyGroup>

  <Import Project="Clang.version.props"/>

  <!-- Shio: Import libc++ and reflection settings before defining base Clang properties. -->
  <Import Project="Clang.libcxx.props"/>
  <Import Project="Clang.cxx26.props"/>

  <PropertyGroup Condition="'$(PlatformToolset)'=='ClangCL'">
    <!-- Shio: This property is used to incrementally build the clang arguments.
           It can be appended to in project files to add project-specific flags. -->
    <Usagi_ClangArgs>$(Usagi_ClangArgs)</Usagi_ClangArgs>
    <!-- Shio: Base arguments for C++26 support. -->
    <Usagi_ClangArgs>$(Usagi_ClangArgs) -Xclang -std=c++26</Usagi_ClangArgs>

    <!-- Shio: Set the target architecture. Fallback to haswell if not specified.
           Haswell is chosen as a baseline for its bit manipulation instructions. -->
    <Usagi_ClangArgs Condition="'$(Usagi_TargetArchitecture)'==''">$(Usagi_ClangArgs) -march=haswell</Usagi_ClangArgs>
    <Usagi_ClangArgs Condition="'$(Usagi_TargetArchitecture)'!=''">$(Usagi_ClangArgs) -march=$(Usagi_TargetArchitecture)</Usagi_ClangArgs>

    <Usagi_ClangArgs>$(Usagi_ClangArgs) /clang:-ferror-limit=0</Usagi_ClangArgs>
    <!-- Ignore unknown arguments. -->
    <Usagi_ClangArgs>$(Usagi_ClangArgs) -Wno-unused-command-line-argument</Usagi_ClangArgs>
    <!-- Shio: Add various warning flags and workarounds. -->
    <Usagi_ClangArgs>$(Usagi_ClangArgs) -Wno-pragma-pack</Usagi_ClangArgs>
    <!-- clang does not really support this argument and it assumes utf-8 input by default. -->
    <!-- <Usagi_ClangArgs>$(Usagi_ClangArgs) -Xclang -finput-charset=UTF-8</Usagi_ClangArgs> -->
    <Usagi_ClangArgs>$(Usagi_ClangArgs) /source-charset:utf-8</Usagi_ClangArgs>
    <Usagi_ClangArgs Condition="'$(Usagi_CppDisableBuiltinStdForwardLike)' == 'true'">
      $(Usagi_ClangArgs) -Xclang -fno-builtin-std-forward_like</Usagi_ClangArgs>
  </PropertyGroup>

  <Import Project="Clang.metaprogramming.props"/>

  <!-- Enforce that MSBuild spawns multiple clang processes for multiple files. -->
  <!-- Because unlike MSVC, clang compiles files single-threaded. -->
  <PropertyGroup Condition="'$(PlatformToolset)'=='ClangCL'">
    <UseMultiToolTask>true</UseMultiToolTask>
    <EnforceProcessCountAcrossBuilds>true</EnforceProcessCountAcrossBuilds>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(PlatformToolset)'=='ClangCL'">
    <ClCompile>
      <AdditionalOptions>$(Usagi_ClangArgs) %(AdditionalOptions)</AdditionalOptions>
      <!-- TODO: This shouldn't be clang-specific -->
      <PreprocessorDefinitions>_USAGI_BUILD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <PropertyGroup Label="Vcpkg" Condition="'$(PlatformToolset)'=='ClangCL'">
    <VcpkgAutoLink>false</VcpkgAutoLink>
    <VcpkgTriplet Condition="'$(Platform)'=='x64'">x64-win-llvm-lto-libcxx</VcpkgTriplet>
  </PropertyGroup>
</Project>
