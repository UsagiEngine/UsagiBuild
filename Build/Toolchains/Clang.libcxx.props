<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Shio: Properties and settings for using libc++ with Clang. -->
  <PropertyGroup Condition="'$(PlatformToolset)'=='ClangCL' and '$(Usagi_CppEnableLibCxx)' == 'true'">
    <!--
      Shio: This points to the installation directory of our custom-built libc++.
            It is sourced from the LIBCXX_INSTALL_DIR environment variable.
            e.g. C:\@Data.Transient\Dev\toolchains\llvm-project\build-libcxx
    -->
    <LIBCXXInstallDir>$(LIBCXX_INSTALL_DIR)</LIBCXXInstallDir>
  </PropertyGroup>

  <!--
    Shio: This target injects a check into the build process to ensure that if
          libc++ is enabled, the path to it is actually set.
  -->
  <Target Name="VerifyLibCxxConfiguration" BeforeTargets="PrepareForBuild" Condition="'$(PlatformToolset)'=='ClangCL' and '$(Usagi_CppEnableLibCxx)' == 'true'">
    <Error Condition="'$(LIBCXXInstallDir)' == ''"
           Text="Shio: 'Usagi_CppEnableLibCxx' is true, but 'LIBCXX_INSTALL_DIR' is not set. Please point it to your libc++ build output directory."/>
  </Target>

  <Import Project="Clang.libcxx.compatibility.props"/>

  <!--
    Shio: This section configures the compiler and linker to use libc++ instead
          of the default MSVC standard library.
  -->
  <ItemDefinitionGroup Condition="'$(PlatformToolset)'=='ClangCL' and '$(Usagi_CppEnableLibCxx)' == 'true'">
    <ClCompile>
      <!-- Flag: /X -->
      <!-- Tells the clang-cl driver to ignore standard include paths (MSVC STL). -->
      <!-- <AdditionalOptions>%(AdditionalOptions) /X</AdditionalOptions> -->

      <!-- Shio: Tells the Clang frontend to exclude MSVC's STL include paths. -->
      <AdditionalOptions>%(AdditionalOptions) -Xclang -nostdinc++</AdditionalOptions>

      <!-- Flag: -stdlib=libc++ -->
      <!-- Tells Clang to use the libc++ standard library. -->
      <AdditionalOptions>%(AdditionalOptions) -Xclang -stdlib=libc++</AdditionalOptions>

      <!-- Shio: Add the libc++ header path. -->
      <AdditionalIncludeDirectories>$(LIBCXXInstallDir)\include\c++\v1;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- Shio: Tells the linker (lld-link) not to link the default MSVC standard library. -->
      <!-- <AdditionalOptions>%(AdditionalOptions) &#45;&#45;nostdlib++</AdditionalOptions>-->
      <!-- Shio: Specify the name of the library to link. -->
      <AdditionalDependencies>libc++.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!--
        Flag: /NODEFAULTLIB:c++.lib
        Tells the linker to ignore the implicit dependency on "c++.lib"
        which is added by "clang-cl -stdlib=libc++". We provide
        "libc++.lib" ourselves via AdditionalDependencies.
      -->
      <AdditionalOptions>%(AdditionalOptions) /NODEFAULTLIB:c++.lib</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <!-- Shio: Linker library paths for different configurations. -->

  <!-- x64|Debug -->
  <ItemDefinitionGroup Condition="'$(Platform)|$(Usagi_SolutionLinkConfiguration)'=='x64|Debug' and '$(Usagi_CppEnableLibCxx)' == 'true'">
    <!--
      Set the C Runtime to Static Debug (/MTd).
      This matches the static libc++.lib you just built.
    -->
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <!--
        NEW: Add the VC++ Runtime Library (Debug)
        This provides the exception handling ABI functions.
      -->
      <AdditionalDependencies>msvcprtd.lib;libvcruntimed.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!--
        Flag: /NODEFAULTLIB:msvcprtd.lib
        Tells the linker not to link the default MSVC standard debug library.
      -->
      <!-- This library is required for exception handling. -->
      <!--<AdditionalOptions>%(AdditionalOptions) /NODEFAULTLIB:msvcprtd.lib</AdditionalOptions>-->
    </Link>
  </ItemDefinitionGroup>

  <!-- x64|Release & RelWithDebInfo -->
  <ItemDefinitionGroup Condition="(('$(Platform)|$(Usagi_SolutionLinkConfiguration)'=='x64|Release') or ('$(Platform)|$(Configuration)'=='x64|RelWithDebInfo')) and '$(Usagi_CppEnableLibCxx)' == 'true'">
    <!--
      Set the C Runtime to Static Release (/MT).
      This matches the static libc++.lib you just built.
    -->
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <!--
        NEW: Add the VC++ Runtime Library (Release)
        This provides the exception handling ABI functions.
      -->
      <!-- Note that both `msvcprt.lib` and `libc++.lib` defines `std::uncaught_exceptions()` -->
      <!-- As a workaround, I must go to libc++'s `exception_msvc.ipp` and comment out its -->
      <!-- function definition. -->
      <AdditionalDependencies>msvcprt.lib;libvcruntime.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!--
        Flag: /NODEFAULTLIB:msvcprt.lib
        Tells the linker not to link the default MSVC standard release library.
      -->
      <!-- This library is required for exception handling. -->
      <!-- <AdditionalOptions>%(AdditionalOptions) /NODEFAULTLIB:msvcprt.lib</AdditionalOptions>-->
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(LIBCXXInstallDir)\lib\$(Usagi_SolutionLinkConfiguration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
