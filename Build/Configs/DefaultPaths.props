<Project>
  <!-- Prevent Engine from including Module files. -->
  <PropertyGroup Condition="'$(_usagiIsEngineProject)' == ''">
    <Usagi_IncludePaths>$(SolutionDir)Modules;$(Usagi_IncludePaths)</Usagi_IncludePaths>
  </PropertyGroup>
  <PropertyGroup>
    <Usagi_IncludePaths>$(SolutionDir)Engine;$(Usagi_IncludePaths)</Usagi_IncludePaths>
    <Usagi_LibraryPaths>$(SolutionDir)$(Platform)\$(Configuration);$(Usagi_LibraryPaths)</Usagi_LibraryPaths>
  </PropertyGroup>
</Project>
